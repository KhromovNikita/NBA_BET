APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://nba:nba@postgres:5432/nba
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=nba
CLICKHOUSE_PASSWORD=nba
REDIS_URL=redis://redis:6379/0
HEALTHCHECK_TIMEOUT_SECONDS=2.0
NBA_API_TIMEOUT_SECONDS=15.0
NBA_API_MAX_CONCURRENCY=1
NBA_API_MIN_INTERVAL_SECONDS=0.75
NBA_API_MAX_ATTEMPTS=4
NBA_API_BACKOFF_BASE_SECONDS=1.0
NBA_API_BACKOFF_MAX_SECONDS=15.0
NBA_API_RESOURCE_LEASE_SECONDS=600
# Phase 3 possession reconstruction is local-only and uses stored Phase 2 PBP.
POSSESSION_RESOURCE_LEASE_SECONDS=300
POSSESSION_BUILD_MAX_CONCURRENCY=4
CLICKHOUSE_OPERATION_TIMEOUT_SECONDS=30
POSSESSION_NORMALIZER_VERSION=nba-pbp-v2
POSSESSION_PARSER_VERSION=analytical-v1
POSSESSION_RULES_VERSION=nba-2025-v1
POSSESSION_OUTPUT_SCHEMA_VERSION=possessions-v1
# Phase 4 lineup reconstruction uses stored Phase 2 box score and PBP inputs.
LINEUP_NORMALIZER_VERSION=nba-pbp-v3-lineup-v1
LINEUP_RECONSTRUCTOR_VERSION=causal-lineup-v1
LINEUP_RULES_VERSION=nba-5x5-v1
LINEUP_OUTPUT_SCHEMA_VERSION=lineup-segments-v1
LINEUP_BUILD_MAX_CONCURRENCY=4
LINEUP_CLAIM_LEASE_SECONDS=300
LIVE_POLL_INTERVAL_SECONDS=3.0
MONTE_CARLO_SIMULATIONS=10000
MODEL_PATH=/app/models
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
CLICKHOUSE_HOST_PORT=8123
REDIS_HOST_PORT=6379
